# ==============================================================================
# 9router Configuration & API Keys
# ==============================================================================
# You can set your API keys below or pass them via GitHub Repository Secrets.
# If a key is left empty, that provider will simply be skipped.

# ------------------------------------------------------------------------------
# 9router Server Settings
# ------------------------------------------------------------------------------
ROUTER_PORT=20128
ROUTER_API_KEY=sk-9router-secret-key-12345

# ------------------------------------------------------------------------------
# Cloudflare Tunnel Settings (Optional)
# ------------------------------------------------------------------------------
# If left empty, a free temporary Quick Tunnel (*.trycloudflare.com) will be generated.
# If you have a named Cloudflare Tunnel, put your Tunnel Token here:
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# AI Provider API Keys
# ------------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Cohere
COHERE_API_KEY=

# Moonshot AI (Kimi)
MOONSHOT_API_KEY=

# Together AI
TOGETHER_API_KEY=

# X.AI (Grok)
XAI_API_KEY=

# Alibaba Qwen (DashScope)
QWEN_API_KEY=
